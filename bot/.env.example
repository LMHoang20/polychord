# Copy to bot/.env and fill in. bot/.env is git-ignored; never commit it.

REPO=LMHoang20/polychord

# Fine-grained token with access to this repo only:
# Contents, Issues, Pull requests: read and write. Variables: read.
GH_TOKEN=

# One of these. CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token`
# (uses a Claude subscription); ANTHROPIC_API_KEY is billed per use.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Optional
CLAUDE_MODEL=
POLL_SECONDS=60
